@startuml
title dot-github Repository Architecture
left to right direction
skinparam shadowing false
skinparam defaultFontName Monospace
skinparam componentStyle rectangle

actor "Maintainer" as maintainer

package "casonk/.github" {
  folder "Community-health defaults\nCONTRIBUTING · SECURITY · templates" as defaults #E0F2FE
  component "Reusable workflows\nCI · install · docs · shell · publish" as workflows #DBEAFE
  component "Secret scan\nGitleaks CLI + baseline" as scan #FEF3C7
  component "Dependabot\naction-pin updates" as dependabot #EDE9FE
  component "pre-commit\nlocal validation" as precommit #DCFCE7
}

cloud "GitHub account" as github #E2E8F0
component "Caller repository\nuses workflows at @main" as caller #FCE7F3

maintainer --> defaults : review and merge
maintainer --> workflows : review and merge
dependabot --> workflows : proposed pin update
maintainer --> precommit : validate before push
defaults --> github : inherited defaults
workflows --> caller : reusable workflow contract
scan --> workflows : called by secret-scan.yml
caller --> github : workflow run

note bottom of workflows
  A main-branch merge is a portfolio-wide deploy:
  callers resolve the workflow at @main.
end note
@enduml
